{{!--
  X.3 and X.5 -- the only two questions MARROW asks before a roll. There is no modifier
  field here on purpose: a bonus in this game is either a Skill or it is Advantage.
--}}
<form class="marrow check-dialog-form">

  {{#if key}}
    <div class="target-preview">
      <span class="label">{{label}}</span>
      <span class="value">{{base}}</span>
    </div>
  {{else}}
    <label class="stacked">
      <span>{{localize 'MARROW.Dialog.WhichCheck'}}</span>
      <select name="key" required>
        <option value="">&mdash;</option>
        {{#each rollable as |group|}}
          <optgroup label="{{group.label}}">
            {{#each group.options as |opt|}}
              <option value="{{opt.key}}">{{opt.label}} &mdash; {{opt.total}}</option>
            {{/each}}
          </optgroup>
        {{/each}}
      </select>
    </label>
  {{/if}}

  {{!-- X.5: "add its bonus" for a Skill that genuinely applies -- nothing says only one can,
        so every held Skill you check in adds its own. --}}
  <fieldset class="skills">
    <legend>{{localize 'MARROW.Dialog.Skill'}}</legend>
    {{#each skills as |skill|}}
      <label class="skill-choice">
        <input type="checkbox" name="skill" value="{{skill.id}}" {{checked skill.checked}} />
        {{skill.name}} ({{skill.rankLabel}} <span class="bonus">+{{skill.bonus}}</span>)
      </label>
    {{else}}
      <p class="notice">{{localize 'MARROW.Dialog.NoSkill'}}</p>
    {{/each}}
  </fieldset>

  {{#if given.length}}
    {{!-- VIII.1's armour matchup, and any [+]/[-] the weapon itself carries. --}}
    <ul class="given-sources">
      {{#each given as |g|}}
        <li class="{{g.effect}}"><span class="mark">{{g.mark}}</span> {{g.source}}</li>
      {{/each}}
    </ul>
  {{/if}}

  <fieldset class="situational">
    <legend>{{localize 'MARROW.Dialog.Situational'}}</legend>
    <label><input type="radio" name="situational" value="advantage" /> [+] {{localize 'MARROW.Advantage'}}</label>
    <label><input type="radio" name="situational" value="" checked /> {{localize 'MARROW.Neither'}}</label>
    <label><input type="radio" name="situational" value="disadvantage" /> [-] {{localize 'MARROW.Disadvantage'}}</label>
  </fieldset>

  {{#if innate}}
    {{!-- XVI.1 / XX: not the player's to switch off, so it is stated rather than offered. --}}
    <p class="innate-note">{{localize 'MARROW.Dialog.InnateDisadvantage'}}</p>
  {{/if}}

</form>
