<div class="marrow chat-card item-card{{#if mystery}} mystery{{/if}}">
  <header class="card-head">
    <img src="{{item.img}}" alt="{{name}}" />
    <span class="what">{{name}}</span>
  </header>
  {{#if formula}}<div class="formula">{{formula}}</div>{{/if}}
  <div class="description">{{{description}}}</div>
</div>
