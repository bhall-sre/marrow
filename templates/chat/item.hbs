<div class="marrow chat-card item-card">
  <header class="card-head">
    <img src="{{item.img}}" alt="{{item.name}}" />
    <span class="what">{{item.name}}</span>
  </header>
  {{#if formula}}<div class="formula">{{formula}}</div>{{/if}}
  <div class="description">{{{item.system.description}}}</div>
</div>
